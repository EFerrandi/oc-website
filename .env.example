# Server
PORT=3000

# Session signing secret — generate a long random value, never commit the real one
SESSION_SECRET=change-me-to-a-long-random-string

# Admin password as a scrypt hash. Generate with: npm run admin:set-password
ADMIN_PASSWORD_HASH=

# Storage
DATABASE_PATH=data/oc.db
UPLOAD_DIR=data/uploads
PREVIEW_DIR=data/uploads/previews

# Longest edge of a generated preview, in pixels (FR-068)
PREVIEW_MAX_EDGE=800

# Upload safety ceiling in bytes — 100 MB. Not a product limit; it exists only to
# reject a clearly mistaken file (FR-067).
MAX_UPLOAD_BYTES=104857600

# Minutes of inactivity before an admin session expires (FR-031)
SESSION_IDLE_MINUTES=120
