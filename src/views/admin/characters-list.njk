{% extends "admin/layout.njk" %}

{% block title %}Characters — Admin{% endblock %}

{% block admin %}
  <h1>Characters</h1>
  <p><a class="chip" href="/admin/characters/new">Add a character</a></p>

  {% if characters.length %}
    <ul class="admin-list">
      {% for c in characters %}
        <li>
          <a href="/admin/characters/{{ c.id }}/edit">{{ c.name }}</a>
          — <a href="/characters/{{ c.slug }}">view</a>
          {# Links to the confirmation on the edit page rather than carrying a
             name field per row: one confirmation, in one place, with one way
             to get it wrong (research R-010). #}
          — <a class="link-danger" href="/admin/characters/{{ c.id }}/edit#delete">Delete</a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="empty-state">No characters yet.</p>
  {% endif %}
{% endblock %}
