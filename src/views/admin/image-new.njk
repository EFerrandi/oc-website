{% extends "admin/layout.njk" %}

{% block title %}New image — Admin{% endblock %}

{% block admin %}
  <h1>Add an image</h1>

  <form method="post" action="/admin/images" enctype="multipart/form-data" class="filters">
    <input type="hidden" name="{{ csrfField }}" value="{{ csrfToken }}">

    <div class="field">
      <label for="image">Image file</label>
      <input type="file" id="image" name="image" accept="image/*" required>
      <p class="hint">Originals are kept at full size; a smaller preview is generated automatically.</p>
    </div>

    <div class="field">
      <label for="alt_text">Alt text (required)</label>
      <input type="text" id="alt_text" name="alt_text" value="{{ values.alt_text or '' }}" required>
    </div>

    <div class="field">
      <label for="artist_id">Artist (required)</label>
      <select id="artist_id" name="artist_id" required>
        <option value="">Choose…</option>
        {% for a in options.artists %}
          <option value="{{ a.id }}" {% if ((values.artist_id or '') | string) == (a.id | string) %}selected{% endif %}>{{ a.name }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="field">
      <label for="short_description">Short description (optional)</label>
      <input type="text" id="short_description" name="short_description" value="{{ values.short_description or '' }}">
    </div>

    <fieldset class="field">
      <legend>Characters (at least one required)</legend>
      {% for c in options.characters %}
        <label class="inline">
          <input type="checkbox" name="character_id" value="{{ c.id }}">
          {{ c.name }}
        </label>
      {% endfor %}
    </fieldset>

    <label class="inline">
      <input type="checkbox" name="is_nsfw" value="1" {% if values.is_nsfw %}checked{% endif %}>
      This image is NSFW
    </label>

    <p><button type="submit">Upload image</button></p>
  </form>
{% endblock %}
