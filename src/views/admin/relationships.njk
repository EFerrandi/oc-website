{% extends "admin/layout.njk" %}

{% block title %}Relationships — Admin{% endblock %}

{% block admin %}
  <h1>Relationships</h1>

  <form method="post" action="/admin/relationships" class="filters">
    <input type="hidden" name="{{ csrfField }}" value="{{ csrfToken }}">

    <div class="field">
      <label for="from_character_id">From</label>
      <select id="from_character_id" name="from_character_id" required>
        <option value="">Choose…</option>
        {% for c in options.characters %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}
      </select>
    </div>

    <div class="field">
      <label for="label">Relationship</label>
      <input type="text" id="label" name="label" value="{{ values.label or '' }}" placeholder="childhood friends" required>
    </div>

    <div class="field">
      <label for="to_character_id">To</label>
      <select id="to_character_id" name="to_character_id" required>
        <option value="">Choose…</option>
        {% for c in options.characters %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}
      </select>
    </div>

    <fieldset class="field">
      <legend>Kind</legend>
      <label class="inline">
        <input type="radio" name="is_one_sided" value="0"{% if values.is_one_sided != '1' %} checked{% endif %}>
        Two-sided — shared, direction does not matter
      </label>
      <label class="inline">
        <input type="radio" name="is_one_sided" value="1"{% if values.is_one_sided == '1' %} checked{% endif %}>
        One-sided — felt by “From” toward “To”
      </label>
    </fieldset>

    <label class="inline">
      <input type="checkbox" name="is_nsfw" value="1">
      This relationship is NSFW
    </label>

    <p><button type="submit">Add relationship</button></p>
  </form>

  {% if relationships.length %}
    <ul class="admin-relationships">
      {% for r in relationships %}
        <li>
          {{ r.fromName }} {{ "→" if r.isOneSided else "—" }} <strong>{{ r.label }}</strong> {{ "→" if r.isOneSided else "—" }} {{ r.toName }}
          <span class="badge">{{ "One-sided" if r.isOneSided else "Two-sided" }}</span>
          {% if r.isNsfw %}<span class="badge-nsfw">NSFW</span>{% endif %}
          <form method="post" action="/admin/relationships/{{ r.id }}/delete" class="inline-form">
            <input type="hidden" name="{{ csrfField }}" value="{{ csrfToken }}">
            <input type="hidden" name="confirm" value="delete">
            <button type="submit">Delete</button>
          </form>
          <details>
            <summary>Edit</summary>
            <form method="post" action="/admin/relationships/{{ r.id }}" class="filters">
              <input type="hidden" name="{{ csrfField }}" value="{{ csrfToken }}">
              <div class="field">
                <label for="from-{{ r.id }}">From</label>
                <select id="from-{{ r.id }}" name="from_character_id" required>
                  {% for c in options.characters %}<option value="{{ c.id }}"{% if c.id == r.fromId %} selected{% endif %}>{{ c.name }}</option>{% endfor %}
                </select>
              </div>
              <div class="field">
                <label for="label-{{ r.id }}">Relationship</label>
                <input type="text" id="label-{{ r.id }}" name="label" value="{{ r.label }}" required>
              </div>
              <div class="field">
                <label for="to-{{ r.id }}">To</label>
                <select id="to-{{ r.id }}" name="to_character_id" required>
                  {% for c in options.characters %}<option value="{{ c.id }}"{% if c.id == r.toId %} selected{% endif %}>{{ c.name }}</option>{% endfor %}
                </select>
              </div>
              <fieldset class="field">
                <legend>Kind</legend>
                <label class="inline"><input type="radio" name="is_one_sided" value="0"{% if not r.isOneSided %} checked{% endif %}> Two-sided</label>
                <label class="inline"><input type="radio" name="is_one_sided" value="1"{% if r.isOneSided %} checked{% endif %}> One-sided</label>
              </fieldset>
              <label class="inline">
                <input type="checkbox" name="swap_direction" value="1">
                Swap direction (From ↔ To)
              </label>
              <label class="inline">
                <input type="checkbox" name="is_nsfw" value="1"{% if r.isNsfw %} checked{% endif %}>
                This relationship is NSFW
              </label>
              <p><button type="submit">Save changes</button></p>
            </form>
          </details>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="empty-state">No relationships yet.</p>
  {% endif %}
{% endblock %}
