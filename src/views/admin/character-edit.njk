{% extends "admin/layout.njk" %}
{% from "admin/partials/character-fields.njk" import characterFields %}

{% block title %}Edit {{ character.name }} — Admin{% endblock %}

{% block admin %}
  <h1>Edit {{ character.name }}</h1>
  <p><a href="/characters/{{ character.slug }}">View public page</a></p>

  <form method="post" action="/admin/characters/{{ character.id }}" class="filters" data-crop-form>
    <input type="hidden" name="{{ csrfField }}" value="{{ csrfToken }}">

    {{ characterFields(options, character, character.tagIds, [], character.jobTitles) }}

    {% set selectedAvatarId = (values.avatar_image_id or character.avatarImageId) | int %}
    {% set selectedAvatar = (character.images | selectattr("id", "equalto", selectedAvatarId) | first) %}
    <div class="field">
      <label for="avatar_image_id">Avatar</label>
      <select id="avatar_image_id" name="avatar_image_id" data-crop-avatar-select>
        {% for img in character.images %}{% if not img.isVideo %}
          <option value="{{ img.id }}" data-preview-src="/media/{{ img.id }}"
                  {% if selectedAvatarId == img.id %}selected{% endif %}>
            {{ img.altText }}{% if img.isNsfw %} (NSFW){% endif %}
          </option>
        {% endif %}{% endfor %}
      </select>
      <p class="hint">Must be one of this character's own still images; videos cannot be avatars.</p>
      <p class="hint avatar-public-notice">An avatar is public: if you pick an NSFW image, its preview is visible to everyone, even visitors who have not turned NSFW on. The full-size image stays hidden.</p>
    </div>

    {% if selectedAvatar %}
      <div class="avatar-crop-controls">
        <div class="avatar-crop-preview">
          <img data-crop-preview src="/media/{{ selectedAvatar.id }}" alt="Preview of the square avatar crop">
        </div>
        <label for="avatar_crop_x">Horizontal position (0–100)</label>
        <input type="range" id="avatar_crop_x" name="avatar_crop_x" min="0" max="100" step="1"
               value="{{ values.avatar_crop_x or character.avatarCropX or 50 }}">
        <label for="avatar_crop_y">Vertical position (0–100)</label>
        <input type="range" id="avatar_crop_y" name="avatar_crop_y" min="0" max="100" step="1"
               value="{{ values.avatar_crop_y or character.avatarCropY or 50 }}">
        <label for="avatar_crop_zoom">Zoom (1–3)</label>
        <input type="range" id="avatar_crop_zoom" name="avatar_crop_zoom" min="1" max="3" step="0.05"
               value="{{ values.avatar_crop_zoom or character.avatarCropZoom or 1 }}">
        <p class="hint">The square crop is saved for this character only; the original image is unchanged.</p>
      </div>
    {% endif %}

    <button type="submit">Save changes</button>
  </form>

  <h2>Images ({{ character.images.length }})</h2>
  <ul>
    {% for img in character.images %}
      <li><a href="/admin/images/{{ img.id }}/edit">{{ img.altText }}</a></li>
    {% endfor %}
  </ul>
  <p><a class="chip" href="/admin/images/new">Add an image</a></p>

  <h2 id="delete">Delete</h2>
  {# Explicit confirmation naming the item — deletion is permanent (FR-053).
     This form is a SIBLING of the edit form above, never nested inside it:
     nested forms are invalid HTML and the parser drops the inner one, which
     would quietly turn "Delete permanently" into a second save button. #}
  <form method="post" action="/admin/characters/{{ character.id }}/delete" class="filters danger-zone">
    <input type="hidden" name="{{ csrfField }}" value="{{ csrfToken }}">
    <div class="field">
      <label for="confirm_name">Type <strong>{{ character.name }}</strong> to confirm permanent deletion</label>
      <input type="text" id="confirm_name" name="confirm_name" autocomplete="off" required>
      {% if fieldErrors and fieldErrors.confirm_name %}
        <p class="field-errors">{{ fieldErrors.confirm_name }}</p>
      {% endif %}
    </div>
    <p class="hint">
      Images and stories shared with another character will survive.
      Anything linked only to {{ character.name }} will be deleted with it.
    </p>
    <button type="submit" class="button-danger">Delete permanently</button>
  </form>
{% endblock %}
