{% extends "admin/layout.njk" %}
{% from "admin/partials/character-fields.njk" import characterFields %}

{% block title %}New character — Admin{% endblock %}

{% block admin %}
  <h1>Add a character</h1>

  {# Character and first image are one submission: a character can never exist
     without an image, so the two must be created together (FR-049). #}
  <form method="post" action="/admin/characters" enctype="multipart/form-data" class="filters">
    <input type="hidden" name="{{ csrfField }}" value="{{ csrfToken }}">

    {{ characterFields(options, values, [], [], titles) }}

    <h2>First image</h2>

    <div class="field">
      <label for="image">Image file</label>
      <input type="file" id="image" name="image" accept="image/*" required>
    </div>

    <div class="field">
      <label for="image_alt_text">Alt text (required)</label>
      <input type="text" id="image_alt_text" name="image_alt_text" value="{{ values.image_alt_text or '' }}" required>
    </div>

    <div class="field">
      <label for="image_artist_id">Artist (required)</label>
      <select id="image_artist_id" name="image_artist_id" required>
        <option value="">Choose…</option>
        {% for a in options.artists %}
          <option value="{{ a.id }}" {% if ((values.image_artist_id or '') | string) == (a.id | string) %}selected{% endif %}>{{ a.name }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="field">
      <label for="image_short_description">Image description (optional)</label>
      <input type="text" id="image_short_description" name="image_short_description" value="{{ values.image_short_description or '' }}">
    </div>

    <label class="inline">
      <input type="checkbox" name="image_is_nsfw" value="1" {% if values.image_is_nsfw %}checked{% endif %}>
      This image is NSFW
    </label>

    <p><button type="submit">Create character</button></p>
  </form>
{% endblock %}
