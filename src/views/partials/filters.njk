{#
  Plain GET form: filters are reflected back so the URL stays shareable and
  reloadable (FR-018), and it works with JavaScript disabled.
  Options come from the visible character set, so none can yield zero results.
#}
<form class="filters filter-bar" method="get" action="/" aria-label="Filter characters">
  <fieldset class="field filter-gender bubble-group">
    <legend>Gender</legend>
    <div class="bubble-options">
      <label class="choice-bubble">
        <input type="radio" name="gender" value="" {% if not applied.gender %}checked{% endif %}>
        <span>Any</span>
      </label>
      {% for g in facets.genders %}
        <label class="choice-bubble">
          <input type="radio" name="gender" value="{{ g.name }}" {% if applied.gender == g.name %}checked{% endif %}>
          <span>{{ g.name }} ({{ g.characterCount }})</span>
        </label>
      {% endfor %}
    </div>
  </fieldset>

  {% if facets.tags.length %}
    <fieldset class="field filter-tags bubble-group">
      <legend>Tags</legend>
      <div class="bubble-options">
        {% for t in facets.tags %}
          <label class="choice-bubble">
            <input type="checkbox" name="tag" value="{{ t.name }}" {% if t.name in applied.tags %}checked{% endif %}>
            <span>{{ t.name }} ({{ t.characterCount }})</span>
          </label>
        {% endfor %}
      </div>
    </fieldset>
  {% endif %}

  <button type="submit" class="filter-apply">Apply filters</button>
</form>
