{#
  Plain GET form: filters are reflected back so the URL stays shareable and
  reloadable (FR-018), and it works with JavaScript disabled.
  Options come from the visible character set, so none can yield zero results.
  Native <details> sections collapse long option lists without any script; a
  section opens by itself when it holds an active filter, so a selection is
  never hidden.
#}
{% set tagsOpen = applied.tags.length > 0 %}
{% set traitsOpen = applied.traits.length > 0 %}

<form class="filters filter-bar" method="get" action="/" aria-label="Filter characters">
  <div class="field filter-gender">
    <label for="gender">Gender</label>
    <select id="gender" name="gender">
      <option value="">Any</option>
      {% for g in facets.genders %}
        <option value="{{ g.name }}" {% if applied.gender == g.name %}selected{% endif %}>
          {{ g.name }} ({{ g.characterCount }})
        </option>
      {% endfor %}
    </select>
  </div>

  {% if facets.tags.length %}
    <details class="filter-section" data-filter-section="tags"{% if tagsOpen %} open{% endif %}>
      <summary>Tags{% if tagsOpen %} ({{ applied.tags.length }}){% endif %}</summary>
      <fieldset class="filter-options">
        <legend class="visually-hidden">Tags</legend>
        {% for t in facets.tags %}
          <label class="inline">
            <input type="checkbox" name="tag" value="{{ t.name }}"
                   {% if t.name in applied.tags %}checked{% endif %}>
            {{ t.name }} ({{ t.characterCount }})
          </label>
        {% endfor %}
      </fieldset>
    </details>
  {% endif %}

  {% if facets.traits.sins.length or facets.traits.virtues.length %}
    <details class="filter-section" data-filter-section="traits"{% if traitsOpen %} open{% endif %}>
      <summary>Sins &amp; Virtues{% if traitsOpen %} ({{ applied.traits.length }}){% endif %}</summary>
      <fieldset class="filter-options">
        <legend class="visually-hidden">Sins &amp; Virtues</legend>
        {% for group, label in {"sins": "Sins", "virtues": "Virtues"} %}
          {% if facets.traits[group].length %}
            <p class="facet-group-label">{{ label }}</p>
            {% for t in facets.traits[group] %}
              <label class="inline">
                <input type="checkbox" name="trait" value="{{ t.name }}"
                       {% if t.name in applied.traits %}checked{% endif %}>
                {{ t.name }} ({{ t.characterCount }})
              </label>
            {% endfor %}
          {% endif %}
        {% endfor %}
      </fieldset>
    </details>
  {% endif %}

  <button type="submit" class="filter-apply">Apply filters</button>
</form>
