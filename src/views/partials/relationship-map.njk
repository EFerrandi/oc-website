{#
  One relationship map, rendered entirely server-side.

  The structure below is a contract, not an implementation detail: the drag
  enhancement in /js/relationship-map.js locates edges by `data-from` /
  `data-to` and nodes by `data-node`, and the integration tests assert the
  shape directly. See contracts/relationship-map.md before changing it.

  Two ordering rules are load-bearing:
    * `.map-edges` is emitted before `.map-nodes`, because SVG has no z-index
      and paints in document order — reversing them would draw lines across
      the avatars.
    * the visible relationship details follow the <svg>, keeping the drawing
      and its complete text equivalent together in document order.
#}

{% macro relationshipMap(layout, rating, title, centerId) %}
  {% set mapId = "map-" + rating %}

  <div class="relationship-map-viewport">
    <svg class="relationship-map"
         style="max-width: {{ layout.width | round(2) }}px; aspect-ratio: {{ layout.width | round(2) }} / {{ layout.height | round(2) }}"
         viewBox="0 0 {{ layout.width | round(2) }} {{ layout.height | round(2) }}"
         role="group"
         aria-labelledby="{{ mapId }}-title"
         data-map="{{ rating }}">
      <title id="{{ mapId }}-title">{{ title }}</title>

      <defs>
        {% for node in layout.nodes %}
          <clipPath id="{{ mapId }}-clip-{{ node.id }}">
            <circle cx="0" cy="0" r="{{ node.r }}"></circle>
          </clipPath>
        {% endfor %}
      <marker id="{{ mapId }}-arrow" class="map-arrow"
              viewBox="0 0 10 10" refX="9" refY="5"
              markerUnits="userSpaceOnUse" markerWidth="16" markerHeight="16"
              orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z"></path>
      </marker>
      </defs>

      <g class="map-edges">
        {% for edge in layout.edges %}
          <a class="map-edge-link" href="#{{ mapId }}-relationship-{{ edge.id }}"
             data-relationship-link="{{ edge.id }}"
             aria-label="{{ edge.fromName }} {{ 'to' if edge.isOneSided else 'and' }} {{ edge.toName }}: {{ edge.label }}">
            <g class="map-edge" data-edge="{{ edge.id }}" data-from="{{ edge.fromId }}" data-to="{{ edge.toId }}" data-label-t="{{ edge.labelT }}"{% if edge.isOneSided %} data-one-sided="1"{% endif %}>
              <path class="map-edge-line"{% if edge.isOneSided %} marker-end="url(#{{ mapId }}-arrow)"{% else %} marker-start="url(#{{ mapId }}-arrow)" marker-end="url(#{{ mapId }}-arrow)"{% endif %}
                    d="M {{ edge.pathStartX | round(2) }} {{ edge.pathStartY | round(2) }}{% if edge.curveOffset %} Q {{ edge.controlX | round(2) }} {{ edge.controlY | round(2) }}{% else %} L{% endif %} {{ edge.pathEndX | round(2) }} {{ edge.pathEndY | round(2) }}"></path>
              <text class="map-edge-label"
                    x="{{ edge.labelX | round(2) }}"
                    y="{{ edge.labelY | round(2) }}"
                    text-anchor="middle"
                    dominant-baseline="middle">{% for line in edge.labelLines %}<tspan x="{{ edge.labelX | round(2) }}" dy="{{ (-(edge.labelLines.length - 1) * 10) if loop.first else 20 }}">{{ line }}</tspan>{% endfor %}</text>
            </g>
          </a>
        {% endfor %}
      </g>

      <g class="map-nodes">
        {% for node in layout.nodes %}
          <a class="map-node"
             data-node="{{ node.id }}"
             data-neighbor-count="{{ node.visibleNeighborCount }}"
             {% if centerId and node.id == centerId %}data-center="1"{% endif %}
             data-crop-zoom="{{ node.cropZoom }}"
             href="/characters/{{ node.slug }}"
             draggable="false"
             transform="translate({{ node.x | round(2) }},{{ node.y | round(2) }})"
             aria-label="{{ node.name }}"
             {% if centerId and node.id == centerId %}aria-current="page"{% endif %}>
            <image class="map-node-avatar"
                   href="{{ node.avatarUrl }}"
                   x="{{ node.imageX | round(2) }}" y="{{ node.imageY | round(2) }}"
                   width="{{ node.imageWidth | round(2) }}" height="{{ node.imageHeight | round(2) }}"
                   preserveAspectRatio="none"
                   clip-path="url(#{{ mapId }}-clip-{{ node.id }})"
                   aria-hidden="true"></image>
            <circle class="map-node-face"
                    data-drag-handle="face"
                    cx="0" cy="0" r="{{ node.r }}"
                    fill="transparent"></circle>
            <circle class="map-node-ring" cx="0" cy="0" r="{{ node.r }}"></circle>
            <text class="map-node-name"
                  x="0" y="{{ node.r + 20 }}"
                  text-anchor="middle">{% for line in node.nameLines %}<tspan x="0" dy="{{ 0 if loop.first else 20 }}">{{ line }}</tspan>{% endfor %}</text>
          </a>
        {% endfor %}
      </g>
    </svg>

    <div class="map-controls" role="group" aria-label="Relationship map controls" hidden>
      <label class="map-label-toggle"><input type="checkbox" data-map-labels checked> Labels</label>
      <button type="button" data-map-zoom-in aria-label="Zoom in">+</button>
      <button type="button" data-map-zoom-out aria-label="Zoom out">−</button>
      <button type="button" data-map-reset aria-label="Reset view">Reset</button>
      <button type="button" data-map-fullscreen aria-label="Enter fullscreen">Fullscreen</button>
    </div>
    <p class="map-status" role="status" aria-live="polite"></p>
  </div>

  <ol class="map-details" aria-label="Relationship details">
    {% for edge in layout.edges %}
      <li id="{{ mapId }}-relationship-{{ edge.id }}" tabindex="-1">
        {% if edge.isOneSided %}<a href="/characters/{{ edge.fromSlug }}">{{ edge.fromName }}</a> → {{ edge.label }} → <a href="/characters/{{ edge.toSlug }}">{{ edge.toName }}</a>{% else %}<a href="/characters/{{ edge.fromSlug }}">{{ edge.fromName }}</a> — {{ edge.label }} — <a href="/characters/{{ edge.toSlug }}">{{ edge.toName }}</a>{% endif %}
      </li>
    {% endfor %}
  </ol>
{% endmacro %}
