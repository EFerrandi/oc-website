{#
  Real form control: the checkbox submits via the Apply button with JavaScript
  disabled, and the enhancement script auto-submits on change (FR-008,
  Constitution III). An unchecked box is simply not submitted, so absence of
  `nsfw` means off — the safe default.
#}
<header class="site-header">
  <a class="site-brand" href="/">OC Gallery</a>

  <div class="site-controls">
    <form class="nsfw-form" method="post" action="/preferences/nsfw">
      <input type="hidden" name="{{ csrfField }}" value="{{ csrfToken }}">
      <input type="hidden" name="returnTo" value="{{ currentPath }}">
      <label class="nsfw-toggle">
        <input type="checkbox" name="nsfw" value="1" {% if showNsfw %}checked{% endif %}>
        <span>Show NSFW content</span>
      </label>
      <button type="submit" class="nsfw-apply">Apply</button>
    </form>

    {% if isAdmin %}
      {# Only ever rendered for a signed-in admin: an anonymous visitor must
         see nothing that reveals the admin area beyond the sign-in link
         that was already here (FR-029). #}
      <a class="admin-entry admin-return" href="/admin">Admin</a>
      <form method="post" action="/admin/logout" class="admin-entry">
        <input type="hidden" name="{{ csrfField }}" value="{{ csrfToken }}">
        <button type="submit" class="link-button">Sign out</button>
      </form>
    {% else %}
      <a class="admin-entry" href="/admin/login">Admin sign in</a>
    {% endif %}
  </div>
</header>
