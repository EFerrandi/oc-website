{% extends "layout.njk" %}

{% block title %}{{ story.title }} — OC Gallery{% endblock %}

{% block content %}
  {% set storyText = story.body.replaceAll("\r\n", "\n").replaceAll("\r", "\n") %}
  <article class="story">
    <h1>{{ story.title }} {% if story.isNsfw %}<span class="badge-nsfw">NSFW</span>{% endif %}</h1>

    {% if characters.length %}
      <p class="card-jobs">
        Featuring
        {% for c in characters %}<a href="/characters/{{ c.slug }}">{{ c.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
      </p>
    {% endif %}

    <div class="story-body">
      {% for paragraph in storyText | paragraphs %}
        {% if paragraph | trim %}
          <p>{% for line in paragraph.split("\n") %}{{ line | trim }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
        {% endif %}
      {% endfor %}
    </div>
  </article>
{% endblock %}
