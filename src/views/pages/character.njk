{% extends "layout.njk" %}
{% from "partials/credit.njk" import credit %}
{% from "partials/image-preview.njk" import imagePreview %}
{% import "partials/relationship-map.njk" as map %}

{% block title %}{{ character.name }} — OC Gallery{% endblock %}

{% block content %}
  <article class="character-profile">

    {# Avatar first, summary beside it. The order here is the reading order for
       a screen reader and for a narrow screen, where the grid collapses to a
       single column — so it is the avatar that must come first in the markup,
       not merely be placed left by CSS. #}
    <header class="profile-header">
      <div class="profile-avatar">
        <img class="profile-avatar-image"
             src="{{ ('/media/' + character.avatar.id) if character.avatar else '/img/placeholder-avatar.svg' }}"
             alt="{{ character.avatar.altText if character.avatar and character.avatar.altText else character.name }}"
             width="220" height="220"
             {% if character.avatar %}style="object-position: {{ character.avatar.cropX or 50 }}% {{ character.avatar.cropY or 50 }}%; transform: scale({{ character.avatar.cropZoom or 1 }}); transform-origin: {{ character.avatar.cropX or 50 }}% {{ character.avatar.cropY or 50 }}%;"{% endif %}>
      </div>

      <div class="profile-summary">
        {% if character.tags.length %}
          <ul class="chips profile-tags" aria-label="Tags">
            {% for t in character.tags %}
              <li><a class="chip" href="/?tag={{ t.name | urlencode }}">{{ t.name }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
        <h1>{{ character.name }}</h1>

        {% if character.jobTitles.length %}
          <p class="card-jobs">{{ character.jobTitles | join(" · ") }}</p>
        {% endif %}

        <p class="character-gender">{{ character.genderName }}</p>
        <p class="character-description">{{ character.shortDescription }}</p>

      </div>
    </header>

    <section class="profile-images">
      <h2>Images</h2>
      {% if character.images.length %}
        <ul class="gallery">
          {% for img in character.images %}
            <li class="card">
              {{ imagePreview(img) }}
              <div class="card-body">
                {% if img.isNsfw %}<span class="badge-nsfw">NSFW</span>{% endif %}
                {% if img.shortDescription %}<p>{{ img.shortDescription }}</p>{% endif %}
                <p class="card-jobs">By {{ credit(img.artistName, img.artistUrl) }}</p>
              </div>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="empty-state">No images to show at the current content setting.</p>
      {% endif %}
    </section>

    {% if character.personality and character.personality.trim() %}
      <section class="profile-personality">
        <h2>Personality</h2>
        {% for paragraph in character.personality | paragraphs %}
          {% if paragraph | trim %}
            <p>{% for line in paragraph.split("\n") %}{{ line | trim }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
          {% endif %}
        {% endfor %}
      </section>
    {% endif %}

    {% if character.physicalDescription and character.physicalDescription.trim() %}
      <section class="profile-physical-description">
        <h2>Physical Description</h2>
        {% for paragraph in character.physicalDescription | paragraphs %}
          {% if paragraph | trim %}
            <p>{% for line in paragraph.split("\n") %}{{ line | trim }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
          {% endif %}
        {% endfor %}
      </section>
    {% endif %}

    <section class="profile-relationships">
      <h2>Relationships</h2>
      {% if character.relationships.length %}
        {% if character.relationshipMap %}
          <div class="relationship-map-frame profile-relationship-map-frame">
            {{ map.relationshipMap(
              character.relationshipMap,
              "profile",
              character.name + " relationships",
              character.id
            ) }}
          </div>
        {% endif %}
        <ul>
          {% for r in character.relationships %}
            <li>
              {% if r.isOneSided %}
                {% if r.from.id == character.id %}
                  {{ r.label }} → <a href="/characters/{{ r.to.slug }}">{{ r.to.name }}</a>
                {% else %}
                  <a href="/characters/{{ r.from.slug }}">{{ r.from.name }}</a> → {{ r.label }}
                {% endif %}
                <span class="relationship-direction">(one-sided)</span>
              {% else %}
                {% set other = r.to if r.from.id == character.id else r.from %}
                {{ r.label }} ↔ <a href="/characters/{{ other.slug }}">{{ other.name }}</a>
                <span class="relationship-direction">(two-sided)</span>
              {% endif %}
              {% if r.isNsfw %}<span class="badge-nsfw">NSFW</span>{% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="empty-state">No relationships to show at the current content setting.</p>
      {% endif %}
    </section>

    <section class="profile-stories">
      <h2>Stories</h2>
      {% if character.stories.length %}
        <ul class="story-list">
          {% for s in character.stories %}
            <li>
              <details class="story">
                {% set storyText = s.body.replaceAll("\r\n", "\n").replaceAll("\r", "\n") %}
                <summary>
                  <span class="story-title">{{ s.title }}</span>
                  {% if s.isNsfw %}<span class="badge-nsfw">NSFW</span>{% endif %}
                  <span class="story-extract">{{ storyText | truncate(140, false, "…") }}</span>
                </summary>
                <div class="story-body">
                  {% for paragraph in storyText | paragraphs %}
                    {% if paragraph | trim %}
                      <p>{% for line in paragraph.split("\n") %}{{ line | trim }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
                    {% endif %}
                  {% endfor %}
                </div>
                <p class="story-permalink"><a href="/stories/{{ s.slug }}">Open this story on its own page</a></p>
              </details>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="empty-state">No stories to show at the current content setting.</p>
      {% endif %}
    </section>

    {% if character.termsOfUse and character.termsOfUse.trim() %}
      <section class="summary-block ownership-block">
        <h2>Ownership</h2>
        <p>Designed by {{ credit(character.artistName, character.artistUrl) }}</p>
        <h3>Terms of use</h3>
        {% set termsText = character.termsOfUse.replaceAll("\r\n", "\n").replaceAll("\r", "\n") %}
        <p class="terms">{% for line in termsText.split("\n") %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
        <ul class="permissions">
          <li>Can be regifted: <strong>{{ "Allowed" if character.canRegift else "Not allowed" }}</strong></li>
          <li>Can be retraded: <strong>{{ "Allowed" if character.canRetrade else "Not allowed" }}</strong></li>
          <li>Can be resold: <strong>{{ "Allowed" if character.canResell else "Not allowed" }}</strong></li>
        </ul>
      </section>
    {% endif %}
  </article>
{% endblock %}
