{
  "name": "oc-website",
  "version": "1.0.0",
  "description": "A website to help me organize all my OCs",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:nsfw": "node --test --test-concurrency=1 \"tests/integration/nsfw-*.test.js\" \"tests/contract/media.test.js\"",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "admin:set-password": "node scripts/set-admin-password.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EFerrandi/oc-website.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/EFerrandi/oc-website/issues"
  },
  "homepage": "https://github.com/EFerrandi/oc-website#readme",
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "multer": "^2.4.0",
    "nunjucks": "^3.2.4",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.0"
  }
}
